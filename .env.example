# Copy to .env.local for local dev, and set the RUNTIME vars in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for deploys.
# .env.local is gitignored and is NOT deployed, so the host needs these set
# explicitly or every DB route returns 503.

# ---- Runtime (required by the deployed app) ----
# Neon POOLED connection string, pointing at the dedicated `nibbsreport` database
# (NOT nexemz's `neondb`). Missing/wrong value => 503 on every DB route.
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxxx-pooler.REGION.aws.neon.tech/nibbsreport?channel_binding=require&sslmode=require"

# Set true in production (HTTPS) so the session cookie carries the Secure flag.
SESSION_COOKIE_SECURE=true

# ---- Runtime (optional: enables outbound email) ----
# Gmail SMTP App Password auth. If unset, credential/reset emails are skipped
# (no crash, no 503) — but "create analyst" and "forgot password" won't email.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Base URL used for sign-in / reset links in outbound emails (and seeded-admin
# emails). Set this so emails sent from local dev point at the deployed app
# instead of localhost. If unset, links fall back to the request's own origin.
APP_URL=https://your-app.vercel.app

# ---- Runtime (optional: enables push notifications) ----
# Web Push for Duty Register reminders and team sign-in/out alerts. Generate a
# key pair once with:  npx web-push generate-vapid-keys
# All four are read by the server at request time (the browser gets the public
# key from /api/push/status), so after adding or changing them a normal redeploy
# is enough. VAPID_PUBLIC_KEY works as a name for the public key too. If unset,
# push is off, the bell names the missing setting, and nothing else breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPublicKeyFromGenerateVapidKeys
VAPID_PRIVATE_KEY=privateKeyFromGenerateVapidKeys
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the reminder cron (cron-job.org sends it as
# "Authorization: Bearer <CRON_SECRET>"). Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace-with-a-long-random-string

# ---- Scripts only (NOT needed on the host) ----
# Used by scripts/db-create.mjs to create the `nibbsreport` database.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Used by scripts/seed-admin.mjs to create/reset the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
